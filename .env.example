# Copy to .env and fill in. Never commit .env.
# This file is the committed template: placeholders ONLY, never real values.

# API key: octopus.energy dashboard -> Personal Details -> API access
OCTOPUS_API_KEY=sk_live_replace_me
OCTOPUS_ACCOUNT_NUMBER=A-XXXXXXXX

# SigenStor plant. Used as the default host by probe.py and control.py
# when no host is given on the command line.
SIGEN_HOST=192.168.0.0

# IOG unit rates in pence per kWh, for the cost summary in watch.py.
# These vary by DNO region -- check your Octopus account. Defaults are
# 4.49 / 29.757 if unset.
IOG_OFF_PEAK_P=4.49
IOG_PEAK_P=29.757

# myenergi Zappi, read-only. Optional -- used to see whether the car is
# drawing, which decides how much headroom is left before the main fuse.
# The username is the HUB serial, not the Zappi's. For the password, either:
#   API key  - myaccount.myenergi.net -> Products -> Gateway row -> Advanced
#              (only on the account that REGISTERED the devices), or
#   app password - set one in the myenergi app. Older route, works the same,
#              and avoids the account-ownership problem.
MYENERGI_SERIAL=12345678
MYENERGI_API_KEY=replace_me
