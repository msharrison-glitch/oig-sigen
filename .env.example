# Copy to .env and fill in. Never commit .env.
# This file is the committed template: placeholders ONLY, never real values.

# API key: octopus.energy dashboard -> Personal Details -> API access
OCTOPUS_API_KEY=sk_live_replace_me
OCTOPUS_ACCOUNT_NUMBER=A-XXXXXXXX

# SigenStor plant. Used as the default host by probe.py and control.py
# when no host is given on the command line.
SIGEN_HOST=192.168.0.0

# IOG unit rates in pence per kWh, for the cost summary in watch.py.
# These vary by DNO region -- check your Octopus account. Defaults are
# 4.49 / 29.757 if unset.
IOG_OFF_PEAK_P=4.49
IOG_PEAK_P=29.757

# myenergi Zappi, read-only. Optional -- used to see whether the car is
# drawing, which decides how much headroom is left before the main fuse.
# The username is the HUB serial, not the Zappi's. For the password, either:
#   API key  - myaccount.myenergi.com -> Products -> Gateway row -> Advanced
#              (only on the account that REGISTERED the devices), or
#   app password - set one in the myenergi app. Older route, works the same,
#              and avoids the account-ownership problem.
MYENERGI_SERIAL=12345678
MYENERGI_API_KEY=replace_me

# Sigen CLOUD account -- only needed to restore the operational mode after a
# Remote EMS release, which the firmware always drops to Self-Consumption.
# These are your mySigen APP credentials, stored in plaintext. Separate from
# SIGEN_HOST above, which is the local Modbus address and needs no login.
# Region: eu (UK/Europe), apac, us, cn.
SIGEN_CLOUD_USERNAME=you@example.com
SIGEN_CLOUD_PASSWORD=replace_me
SIGEN_CLOUD_REGION=eu

# --- poll cadences (optional) --------------------------------------------
#
# How often the Octopus schedule is checked. Both are optional; the defaults
# below are what ships. Minimum 15s for either -- below that you are waiting
# on the plant's own actuation latency rather than on detection, so it buys
# nothing and only adds load. A few seconds of random jitter is added
# automatically, because everyone running this is on the same tariff and
# synchronised polling is what gets an API rate-limited.

# While a slot is LIVE -- charging, or waiting for the car to start drawing.
# This is the one that matters: Octopus withdraws slots at short notice, and
# every second between the withdrawal and our noticing is imported at the
# PEAK rate. At 30s, worst case is about 45s of peak import (30s to notice,
# 5-25s to release). Raise it to be a lighter guest on the API; lower it if
# you would rather pay a few more calls for a shorter exposure.
IOG_POLL_CHARGING_SECONDS=30

# When nothing is happening. Governs how quickly a NEW slot is noticed --
# which matters because the first dispatch after you plug in starts within a
# few minutes and runs only to the next half-hour boundary. No money is at
# risk here, only missed opportunity, so the default is looser. 300s is 288
# calls a day.
IOG_POLL_IDLE_SECONDS=300

# Where mutable state lives (.lease.json, cached tokens). Leave unset on a
# normal install -- it defaults to beside the scripts, which is where the
# cron deadman looks. Containers set it to a volume so state survives a
# restart; losing .lease.json means the deadman has nothing to act on.
# IOG_STATE_DIR=/state
