# Per-site agent. Install to /etc/systemd/system/oig-sigen.service
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now oig-sigen
#   journalctl -u oig-sigen -f
#
# WorkingDirectory is load-bearing: control.py writes .lease.json beside the
# scripts, and the cron deadman looks for it in the same place. Run the two
# as the same user from the same directory or the deadman silently protects
# nothing.

[Unit]
Description=OIG to SigenStor reconciliation agent
Documentation=https://github.com/msharrison-glitch/oig-sigen
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=oig
Group=oig
WorkingDirectory=/opt/oig-sigen
# Three flags that are not optional in a real deployment:
#
#   --bonus-only    right if your plant already grid-charges overnight, which
#                   most do. Drop it if yours does not and the battery still
#                   has room at 23:30.
#   --require-zappi without it the agent acts on plannedDispatches, which is a
#                   forecast about the car. A slot that never completes bills
#                   at PEAK, so this buys expensive power while reporting a
#                   saving.
#   --heartbeat-url without it the watchdog cannot see a lease. It would
#                   report WARN ("nothing held") for an agent that died
#                   holding mode 3 -- worse than no watchdog, because it reads
#                   as reassurance.
#
# Set SITE_TOKEN in /etc/default/oig-sigen (mode 600, owned by oig).
EnvironmentFile=-/etc/default/oig-sigen
ExecStart=/usr/bin/python3 /opt/oig-sigen/reconcile.py \
    --kw 5 --bonus-only --require-zappi \
    --heartbeat-url ${WATCHDOG_URL} --site-token ${SITE_TOKEN}

# SIGTERM is wired to the release path. Give it room: a release is 5-15 s,
# and with_retry may take another second or two on a flaky link.
KillSignal=SIGTERM
TimeoutStopSec=60

# Belt and braces. `release` is idempotent -- a no-op when nothing is held,
# and the one thing that must happen when the agent goes away.
ExecStopPost=/usr/bin/python3 /opt/oig-sigen/control.py release

Restart=always
RestartSec=30

# The agent needs its own directory (.lease.json, .octopus-token.json) and
# nothing else on the box.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/oig-sigen

[Install]
WantedBy=multi-user.target
